generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Noticia {
  id               Int       @id @default(autoincrement())
  titulo           String
  link             String    @unique
  descripcion      String?
  contenido        String?   @db.Text
  resumen          String?   @db.Text
  impacto          String?   // "FUERTE", "MODERADO", "DEBIL"
  sentimiento      String?   // "POSITIVO", "NEGATIVO", "NEUTRO"
  razonImpacto     String?
  razonSentimiento String?
  fuente           String?
  pais             String?   // "AR", "ES", etc.
  publicadoEn      DateTime?
  procesadoEn      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  leerMasTarde LeerMasTarde[]
  favoritos    Favorito[]

  @@map("noticias")
}

model Feed {
  id        Int      @id @default(autoincrement())
  nombre    String
  url       String   @unique
  activo    Boolean  @default(true)
  pais      String?  // "AR", "ES", etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feeds")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leerMasTarde LeerMasTarde[]
  favoritos    Favorito[]

  @@map("usuarios")
}

model LeerMasTarde {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  noticiaId Int
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  noticia Noticia @relation(fields: [noticiaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, noticiaId])
  @@map("leer_mas_tarde")
}

model Favorito {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  noticiaId Int
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  noticia Noticia @relation(fields: [noticiaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, noticiaId])
  @@map("favoritos")
}
